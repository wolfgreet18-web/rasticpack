<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="کپی سریع" android:textSize="30sp" android:textStyle="bold" android:textColor="#17202A" android:gravity="right" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="متن‌های پرکاربردت را ذخیره کن و برای هرکدام یک ویجت روی صفحه اصلی بساز." android:textSize="16sp" android:textColor="#607080" android:gravity="right" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/title" android:hint="نام (مثلاً کارت بانک)" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/text" android:hint="متنی که باید کپی شود" android:gravity="top|right" android:minLines="3" android:inputType="textMultiLine" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/add" android:text="ذخیره متن" android:textColor="#FFFFFF" android:background="@drawable/button_bg" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="متن‌های ذخیره‌شده" android:textSize="20sp" android:textStyle="bold" android:gravity="right" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/list" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="نکته: بعد از افزودن ویجت، می‌توانی چند ویجت مختلف داشته باشی؛ هر ویجت یک متن جدا را با یک لمس کپی می‌کند." android:textSize="14sp" android:textColor="#607080" android:gravity="right" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
