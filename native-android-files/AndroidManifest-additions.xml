<!--
  این بخش رو داخل تگ <application> ... </application> فایل
  android/app/src/main/AndroidManifest.xml (که Capacitor خودش ساخته) اضافه کن.
  آخرین تگ </application> رو پیدا کن و این دو بلوک رو درست قبلش بچسبون.
-->

<receiver
    android:name="com.example.cardwidget.CardWidgetProvider"
    android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="com.example.cardwidget.ACTION_COPY_CARD" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/card_widget_info" />
</receiver>

<activity
    android:name="com.example.cardwidget.CardWidgetConfigureActivity"
    android:exported="true"
    android:theme="@android:style/Theme.DeviceDefault.Light.Dialog">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
    </intent-filter>
</activity>
