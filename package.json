{
  "name": "rasticpack-app",
  "version": "1.0.0",
  "description": "رستیک‌پک - ماشین‌حساب کارتن",
  "private": true,
  "scripts": {
    "build:sqlite": "esbuild src/sqlite-entry.js --bundle --format=iife --platform=browser --outfile=www/vendor/sqlite-bundle.js",
    "build:android": "npm run build:sqlite && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor-community/sqlite": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "esbuild": "^0.23.0"
  }
}
